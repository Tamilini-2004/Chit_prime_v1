rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(uid())).data.role in ['admin','super_admin'];
    }
    function isForeman(groupId) {
      return isAuth() && get(/databases/$(database)/documents/groups/$(groupId)).data.foremanUid == uid();
    }
    function isMember(groupId) {
      return isAuth() && uid() in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && uid() == userId;
      allow update: if isAuth() && (uid() == userId || isAdmin());
      allow delete: if isAdmin();

      match /scoreHistory/{docId} {
        allow read: if isAuth() && (uid() == userId || isAdmin());
        allow write: if isAdmin();
      }
    }

    // ── Groups ────────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (isForeman(groupId) || isAdmin());
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow read: if isAuth() && (isMember(groupId) || isAdmin());
        allow write: if isAuth() && (isForeman(groupId) || isAdmin() || uid() == memberId);
      }
    }

    // ── Contributions ─────────────────────────────────────────────────────────
    match /contributions/{docId} {
      allow read: if isAuth() && (
        resource.data.userId == uid() ||
        isForeman(resource.data.groupId) ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Auctions ──────────────────────────────────────────────────────────────
    match /auctions/{auctionId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isAdmin() || isForeman(resource.data.groupId));
      allow update: if isAuth() && (isAdmin() || isForeman(resource.data.groupId));
      allow delete: if isAdmin();
    }

    // ── Payouts ───────────────────────────────────────────────────────────────
    match /payouts/{payoutId} {
      allow read: if isAuth() && (
        resource.data.winnerUid == uid() ||
        isForeman(resource.data.groupId) ||
        isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAuth() && (isForeman(resource.data.groupId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.toUid == uid();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.toUid == uid();
      allow delete: if isAuth() && resource.data.toUid == uid();
    }

    // ── Messages ──────────────────────────────────────────────────────────────
    match /messages/{msgId} {
      allow read: if isAuth() && (
        resource.data.fromUid == uid() || resource.data.toUid == uid()
      );
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.toUid == uid();
      allow delete: if isAdmin();
    }

    // ── Fraud Alerts ──────────────────────────────────────────────────────────
    match /fraud_alerts/{alertId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Admin Actions Log ─────────────────────────────────────────────────────
    match /admin_actions_log/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── Platform Settings ─────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
